            If ts.CustomTab Then
                TabCount = TabCount + 1
                
                ' Resizes the TabData array, increasing its number of
                ' columns to the number of tab stops found
                ReDim Preserve TabData(1 To 3, 1 To TabCount)
                
                ' Adding 'Position' tab stop parameter
                TabData(1, TabCount) = ts.Position
                
                ' Adding 'Alignment' tab stop parameter
                TabData(2, TabCount) = ts.Alignment
                
                ' Adding 'Leader' tab stop parameter
                TabData(3, TabCount) = ts.Leader
            End If
        Next ts
        
        ' Adding tab stops in 'Formula' style of target document
        If TabCount >= 2 Then
            With stl.ParagraphFormat.TabStops
                
                ' Delating all tab stops in 'Formula' style of target document
                .ClearAll
                
                ' Adding first tab stop in 'Formula' style of target document
                .Add Position:=TabData(1, 1), _
                     Alignment:=TabData(2, 1), _
                     Leader:=TabData(3, 1)
                
                ' Adding second tab stop in 'Formula' style of target document
                .Add Position:=TabData(1, 2), _
                     Alignment:=TabData(2, 2), _
                     Leader:=TabData(3, 2)
            End With
        End If
    
    End If
    
    TabDataCount = UBound(TabData, 2)
    
    ' Iterating target document paragraphs
    i = 0
    For i = 1 To TargetDocParagsCount
        Set Parag = TargetDocParags(i)
        If Parag.Style = StyleName Then
            
            ' Iterating tab stops in 'Formula'-styled paragraphs of target document
            TabCount = 0
            TabStopRight = False
            For Each ts In Parag.Range.ParagraphFormat.TabStops
                If ts.CustomTab Then
                    TabCount = TabCount + 1
                    
                    ' Checking whether the number of tab stops in 'Formula'-styled paragraph
                    ' of target document exceeds the number of tab stops in the TabDataCount array
                    If TabCount <= TabDataCount Then
                        
                        ' Checking the correctness of the positions and types of tab stops
                        ' in 'Formula'-styled paragraph of target document
                        If ts.Position = TabData(1, TabCount) And _
                           ts.Alignment = TabData(2, TabCount) And _
                           ts.Leader = TabData(3, TabCount) Then
                            TabStopRight = True
                        Else
                            TabStopRight = False
                        End If
                    Else
                        TabStopRight = False
                    End If
                End If
            Next ts
            
            ' Checking if tab stops positions and types in a paragraph are correct
            If TabStopRight = False Then
                
                ' If tab stops positions and types are incorrect than delating all
                ' tab stops in 'Formula'-styled paragraph of target document
                Parag.Range.ParagraphFormat.TabStops.ClearAll
                
                ' Adding tab in 'Formula'-styled paragraph of target document if that is neccessary
                TabCount = 0
                For TabCount = 1 To TabDataCount
                    Parag.Range.ParagraphFormat.TabStops.Add _
                    Position:=TabData(1, TabCount), _
                    Alignment:=TabData(2, TabCount), _
                    Leader:=TabData(3, TabCount)
                Next TabCount
            End If
             
            ' Delating all tabs in 'Formula'-styled paragraph of target document
