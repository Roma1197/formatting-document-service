    CurrentFolder = CurrentDoc.Path & "\"
    
    ' Creating and saving a file selection dialog in the FilePicker variable
    Set FilePicker = Application.FileDialog(msoFileDialogFilePicker)
    
    ' Choosing target document with file
    With FilePicker
        .AllowMultiSelect = False
        .Title = "Choose target Word document"
        .InitialFileName = CurrentFolder
        .Filters.Clear
        .Filters.Add "Word document", "*.docx"
        
        If .Show = -1 Then
            TargetDocPath = .SelectedItems(1)
        Else
            Exit Sub
        End If
    End With
    
    ' Opening target document in the background
    Set TargetDoc = Documents.Open(FileName:=TargetDocPath, Visible:=False)
    
    ' Getting all paragraphs, paragraphs count and full path of sample document
    Set TargetDocParags = TargetDoc.Paragraphs
    TargetDocParagsCount = TargetDocParags.Count
    Set TargetDocStyles = TargetDoc.Styles
    TargetDocFullName = TargetDoc.FullName
    
    ' Enable 'Resume Next mode': if an error occurs, do not stop the program, but proceed to the next line
    On Error Resume Next
    
    ' Copy styles from current document to target document
    For Each srcStyle In CurrentDoc.Styles
        
        If srcStyle.QuickStyle Then
            
            Set dstStyle = TargetDoc.Styles(srcStyle.NameLocal)
            
            If dstStyle Is Nothing Then
                Set dstStyle = TargetDoc.Styles.Add(Name:=srcStyle.NameLocal, Type:=srcStyle.Type)
            End If
            
            ' Copies style fonts
            With dstStyle.Font
                .Name = srcStyle.Font.Name
                .Size = srcStyle.Font.Size
                .Bold = srcStyle.Font.Bold
                .Italic = srcStyle.Font.Italic
                .Underline = srcStyle.Font.Underline
                .Color = srcStyle.Font.Color
                .AllCaps = srcStyle.Font.AllCaps
                .SmallCaps = srcStyle.Font.SmallCaps
            End With
            
            ' Copies paragraph properties
            With dstStyle.ParagraphFormat
               .Alignment = srcStyle.ParagraphFormat.Alignment
               .LeftIndent = srcStyle.ParagraphFormat.LeftIndent
               .RightIndent = srcStyle.ParagraphFormat.RightIndent
               .FirstLineIndent = srcStyle.ParagraphFormat.FirstLineIndent
               .SpaceBefore = srcStyle.ParagraphFormat.SpaceBefore
               .SpaceAfter = srcStyle.ParagraphFormat.SpaceAfter
               .LineSpacingRule = srcStyle.ParagraphFormat.LineSpacingRule
               .LineSpacing = srcStyle.ParagraphFormat.LineSpacing
               .KeepTogether = srcStyle.ParagraphFormat.KeepTogether
               .KeepWithNext = srcStyle.ParagraphFormat.KeepWithNext
           End With
           
           ' Copies tabulation
           dstStyle.ParagraphFormat.TabStops.ClearAll
           
           For Each ts In srcStyle.ParagraphFormat.TabStops
               dstStyle.ParagraphFormat.TabStops.Add _
                   Position:=ts.Position, _
                   Alignment:=ts.Alignment, _
                   Leader:=ts.Leader
           Next
           
           ' Copies borders and fill
           With dstStyle.Borders(wdBorderBottom)
               .LineStyle = srcStyle.Borders(wdBorderBottom).LineStyle
               .LineWidth = srcStyle.Borders(wdBorderBottom).LineWidth
           End With
           
           ' Copies languages
           dstStyle.LanguageID = srcStyle.LanguageID
           
           Set dstStyle.NextParagraphStyle = CurrentDoc.Styles(srcStyle.NextParagraphStyle.NameLocal)
           
        End If
           
    Next srcStyle
        
    ' Disable 'Resume Next mode' and return to standard VBA error handling
    On Error GoTo 0
    
    ' Coping margins, header size and footer size from sample document to target document
    For i = 1 To CurrentDoc.Sections.Count
        If i <= TargetDoc.Sections.Count Then
            With TargetDoc.Sections(i).PageSetup
                .TopMargin = CurrentDoc.Sections(i).PageSetup.TopMargin
                .BottomMargin = CurrentDoc.Sections(i).PageSetup.BottomMargin
                .LeftMargin = CurrentDoc.Sections(i).PageSetup.LeftMargin
                .RightMargin = CurrentDoc.Sections(i).PageSetup.RightMargin
                .HeaderDistance = CurrentDoc.Sections(i).PageSetup.HeaderDistance
                .FooterDistance = CurrentDoc.Sections(i).PageSetup.FooterDistance
            End With
        End If
    Next i
    
    ' Assigning the StyleName variable the name of the style "Formula"
    StyleName = "Formula"
    
    ' Search first formula paragraph in current document
    i = 0
    For i = 1 To CurrentDocParagsCount
        Set Parag = CurrentDocParags(i)
        If Parag.Style = StyleName Then
            Set FormulaParag = Parag
            Exit For
        End If
    Next i
    
    ' Assign the list of all target document style names to the stl variable
    Set stl = TargetDoc.Styles(StyleName)
    
    ' Checking for the presence of a paragraph with a formula in sample document
    If Not FormulaParag Is Nothing Then
        
        ' Coping tab stops parameters from the first paragraph with
        ' a formula in sample document in TabData array
        TabCount = 0
